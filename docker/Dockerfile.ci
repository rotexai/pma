# syntax=docker/dockerfile:1
#
# Builds Vikunja (https://vikunja.io) from a pinned upstream tag, with one
# change: VIKUNJA_FRONTEND_BASE is set before the frontend build so the
# built JS router/assets expect to be served from /pma/ instead of /.
# Vikunja's frontend base path is baked in at build time (not configurable
# at runtime), so this can't be done via env vars on the stock
# vikunja/vikunja image - see README.md.
#
# Unlike upstream's own Dockerfile, this does NOT use their xgo-based
# cross-compile stage (ghcr.io/techknowlogick/xgo) - that image's internal
# build/cleanup script reliably fails under Kaniko (a `chown /build: no
# such file or directory` from its own wrapper, verified locally: the
# actual `go build` step works fine, xgo's post-build ownership fixup
# doesn't run cleanly in Kaniko's exec environment). xgo exists to support
# CGO cross-compilation to many OS/arch targets; we only need linux/amd64
# for this cluster and don't need CGO (Vikunja's sqlite driver is
# cgo-based, but we run Postgres, and a plain `CGO_ENABLED=0 go build`
# compiles the full tree fine - the sqlite driver package still builds,
# it just can't be selected as VIKUNJA_DATABASE_TYPE at runtime). A plain
# `golang:1.27-alpine` build stage sidesteps the whole issue.

ARG VIKUNJA_VERSION=v2.6.0

FROM alpine/git:2.47.2 AS source
ARG VIKUNJA_VERSION
WORKDIR /src
RUN git clone --branch "${VIKUNJA_VERSION}" --depth 1 https://github.com/go-vikunja/vikunja.git .

FROM --platform=$BUILDPLATFORM node:24.20.0-alpine AS frontendbuilder
WORKDIR /build
ENV PNPM_CACHE_FOLDER=.cache/pnpm/
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV CYPRESS_INSTALL_BINARY=0
# pma: bake the /pma/ subpath into the frontend build.
ENV VIKUNJA_FRONTEND_BASE=/pma/
COPY --from=source /src/frontend/pnpm-lock.yaml /src/frontend/package.json /src/frontend/pnpm-workspace.yaml ./
RUN npm install -g corepack && corepack enable && \
    pnpm install --frozen-lockfile
COPY --from=source /src/frontend/ ./
ARG VIKUNJA_VERSION
RUN echo "{\"VERSION\": \"${VIKUNJA_VERSION}\"}" > src/version.json && pnpm run build

FROM golang:1.27-alpine AS apibuilder
WORKDIR /go/src/code.vikunja.io/api
COPY --from=source /src/ ./
COPY --from=frontendbuilder /build/dist ./frontend/dist

ARG VIKUNJA_VERSION
ENV CGO_ENABLED=0
ENV GOOS=linux
ENV GOARCH=amd64

RUN go build \
      -ldflags "-X \"code.vikunja.io/api/pkg/version.Version=${VIKUNJA_VERSION}\" -X \"main.Tags=osusergo netgo\"" \
      -o /vikunja \
      .

RUN mkdir -p /tmp && chmod 1777 /tmp

FROM scratch

LABEL org.opencontainers.image.title='pma'
LABEL org.opencontainers.image.description='Vikunja, built with /pma/ as its frontend base path'
LABEL org.opencontainers.image.source='https://github.com/go-vikunja/vikunja'
LABEL org.opencontainers.image.licenses='AGPLv3'

WORKDIR /app/vikunja
ENTRYPOINT [ "/app/vikunja/vikunja" ]
EXPOSE 3456

COPY --from=apibuilder --chown=1000:1000 --chmod=1777 /tmp /tmp

USER 1000

ENV VIKUNJA_SERVICE_ROOTPATH=/app/vikunja/

COPY --from=apibuilder /vikunja vikunja
COPY --from=apibuilder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
